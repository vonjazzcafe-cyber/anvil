<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>Anvil.Host</AssemblyName>
    <RootNamespace>Anvil.Host</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0618;CA1416</NoWarn>
    <DebugType>portable</DebugType>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine/Anvil.Engine.csproj" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>../../tools/roslyn/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>../../tools/roslyn/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
